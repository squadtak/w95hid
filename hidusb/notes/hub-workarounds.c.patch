+/* sleep: a wait on an event nobody signals, with a time-out */
+static void DelayMs(ULONG ms)
+{
+    KEVENT ev;
+    LARGE_INTEGER t;
+
+    KeInitializeEvent(&ev, NotificationEvent, FALSE);
+    t.QuadPart = -(LONGLONG)ms * 10000;
+    KeWaitForSingleObject(&ev, Suspended, KernelMode, FALSE, &t);
+}
